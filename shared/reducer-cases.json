    "order": ["a"],
    "nextSeq": 1,
    "agents": { "a": { "name": "Novo", "role": "qa", "seq": 0, "status": "thinking", "task": "x", "lastEventTs": 3 } }
  },
  {
    "name": "seq não é reaproveitado depois que um agente sai",
    "events": [
      { "type": "agent_joined", "agentId": "a", "name": "A", "role": "dev", "ts": 1 },
      { "type": "agent_joined", "agentId": "b", "name": "B", "role": "dev", "ts": 2 },
      { "type": "agent_left", "agentId": "a", "ts": 3 },
      { "type": "agent_joined", "agentId": "c", "name": "C", "role": "dev", "ts": 4 }
    ],
    "order": ["b", "c"],
    "nextSeq": 3,
    "agents": { "b": { "seq": 1 }, "c": { "seq": 2 } }
  },
  {
    "name": "evento de agente desconhecido é ignorado",
    "events": [
      { "type": "agent_joined", "agentId": "a", "name": "A", "role": "dev", "ts": 1 },
      { "type": "thinking", "agentId": "fantasma", "ts": 2 },
      { "type": "agent_left", "agentId": "fantasma", "ts": 3 }
    ],
    "order": ["a"],
    "nextSeq": 1,
    "agents": { "a": { "status": "idle", "lastEventTs": 1 } }
