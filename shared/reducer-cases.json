    }
  },
  {
    "name": "entrar de novo atualiza nome e papel sem mudar status nem seq",
    "events": [
      { "type": "agent_joined", "agentId": "a", "name": "A", "role": "dev", "ts": 1 },
      { "type": "task_started", "agentId": "a", "task": "x", "ts": 2 },
